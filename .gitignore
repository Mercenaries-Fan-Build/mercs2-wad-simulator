/target/
/target_probe/
Cargo.lock

# Python bytecode from tools/
__pycache__/
*.pyc

# mercs2_workshop local output: regenerable asset exports (OBJ/MTL/PNG) and the
# scratch sandbox scene written by the workbench's "Save scene" button.
/workshop_export/
/workshop_scene.json

# Machine-local game paths (scripts/find-vz-wad.sh). Never committed: the path is
# machine-specific and points at retail assets we do not redistribute.
/.mercs2-local.toml

# Crucible's local LanceDB code index (.crucible/manifest.json + lancedb/). A regenerable
# machine-local cache, ~420 MB across 33k files — never committed.
/.crucible/

# macOS Finder metadata.
.DS_Store

# Vendored source data for the workshop/quartermaster: game corpus dumps, ECS/lua
# schemas, and modder Shipments (manifest + source GLBs/textures). Large, machine-local,
# and often derived from retail assets we do not redistribute — kept out of the repo.
/workshop_data/
